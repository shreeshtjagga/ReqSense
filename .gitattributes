# Auto detect text files and perform LF normalization on checkin
* text=auto eol=lf

# Explicit text files
*.py text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.env* text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Batch scripts (Windows requires CRLF)
*.bat text eol=crlf
*.cmd text eol=crlf
