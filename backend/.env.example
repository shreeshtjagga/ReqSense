DATABASE_URL=sqlite+aiosqlite:///./reqsense_local.db

REDIS_URL=memory://
CELERY_BROKER_URL=memory://
CELERY_RESULT_BACKEND=memory://

GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TIMEOUT_SECONDS=15

SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_TIMEOUT_SECONDS=5
FROM_EMAIL=noreply@reqsense.ai

SECRET_KEY=your_super_secret_jwt_key_min_32_chars_replace_this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
STREAM_TOKEN_EXPIRE_SECONDS=60

CHROMA_MODE=local
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=reqsense
CHROMA_PERSIST_DIRECTORY=./chroma_data
CHROMA_TIMEOUT_SECONDS=10

EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_VERSION=v1

S3_BUCKET_NAME=reqsense-srs-docs
S3_ACCESS_KEY_ID=your_key
S3_SECRET_ACCESS_KEY=your_secret
S3_ENDPOINT_URL=
S3_REGION=auto
S3_TIMEOUT_SECONDS=10

SENTRY_DSN=

FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

RATE_LIMIT_MESSAGES_PER_MINUTE=30
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_ANALYTICS_PER_MINUTE=100
RATE_LIMIT_DOWNLOADS_PER_MINUTE=20

PROMPT_VERSION=v1.0
ENV=development
